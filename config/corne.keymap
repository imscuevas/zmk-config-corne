#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        ltq: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_QUICK";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
            flavor = "hold-preferred";
        };

        bt0: bt0 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_DISC 0>;
        };

        bt1: bt1 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_DISC 1>;
        };

        bt2: bt2 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT2";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt BT_DISC 2>;
        };

        bt3: bt3 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT3";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt BT_DISC 3>;
        };

        bt4: bt4 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT4";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&bt BT_DISC 4>;
        };

        btc: btc {
            compatible = "zmk,behavior-tap-dance";
            label = "BTC";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>, <&bt BT_CLR_ALL>;
        };

        ot: ot {
            compatible = "zmk,behavior-tap-dance";
            label = "OT";
            #binding-cells = <0>;
            bindings = <&out OUT_USB>, <&out OUT_BLE>, <&out OUT_TOG>;
        };

        r_or_4: r_or_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "R_OR_4";
            #binding-cells = <0>;
            bindings = <&mkp RCLK>, <&mkp MB4>;
        };

        m_or_5: m_or_5 {
            compatible = "zmk,behavior-tap-dance";
            label = "M_OR_5";
            #binding-cells = <0>;
            bindings = <&mkp MCLK>, <&mkp MB5>;
        };

        caps_lock_word: caps_lock_word {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPS_LOCK_WORD";
            bindings = <&kp CAPS>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            bindings = <
&none            &kp Q       &hm RIGHT_ALT W  &kp E          &kp R         &kp T         &kp Y             &kp U         &kp I          &hm RIGHT_ALT O  &kp P          &none
&caps_lock_word  &hm LGUI A  &hm LALT S       &hm LCTRL D    &hm LSHFT F   &kp G         &kp H             &hm RSHFT J   &hm RCTRL K    &hm LEFT_ALT L   &hm RGUI SEMI  &kp SQT
&mo 7            &kp Z       &kp X            &kp C          &kp V         &kp B         &kp N             &kp M         &kp COMMA      &kp PERIOD       &kp SLASH      &none
                                              &ltq 4 ESCAPE  &ltq 2 SPACE  &ltq 3 TAB    &ltq 5 BACKSPACE  &ltq 1 ENTER  &ltq 6 DELETE
            >;
        };

        numbers {
            bindings = <
&trans  &kp SINGLE_QUOTE      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NON_US_HASH      &trans  &trans      &trans     &kp RIGHT_ALT  &trans         &trans
&trans  &kp LEFT_BRACKET      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RIGHT_BRACKET    &trans  &kp RSHIFT  &kp RCTRL  &kp LEFT_ALT   &kp RIGHT_GUI  &trans
&trans  &kp NON_US_BACKSLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp GRAVE            &trans  &trans      &kp W      &kp Q          &kp Z          &trans
                                            &kp EQUAL     &kp NUMBER_0  &kp MINUS            &trans  &trans      &trans
            >;
        };

        navigation {
            bindings = <
&none  &none     &kp RIGHT_ALT  &none      &none      &none    &kp LC(SLASH)  &kp LC(PERIOD)  &kp LC(I)     &kp LC(B)  &kp LC(T)     &none
&none  &kp LGUI  &kp LALT       &kp LCTRL  &kp LSHFT  &none    &kp LEFT       &kp DOWN        &kp UP_ARROW  &kp RIGHT  &kp CAPSLOCK  &studio_unlock
&none  &none     &none          &none      &none      &none    &kp HOME       &kp PAGE_DOWN   &kp PAGE_UP   &kp END    &kp INSERT    &none
                                &none      &none      &none    &kp BACKSPACE  &kp ENTER       &kp DELETE
            >;
        };

        mouse {
            bindings = <
&none  &none     &kp RIGHT_ALT  &none      &none      &none    &kp LC(SLASH)   &kp LC(PERIOD)  &kp LC(I)     &kp LC(B)        &kp LC(T)  &none
&none  &kp LGUI  &kp LALT       &kp LCTRL  &kp LSHFT  &none    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none      &none
&none  &none     &none          &none      &none      &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none      &none
                                &none      &none      &none    &r_or_4         &mkp LCLK       &m_or_5
            >;
        };

        media {
            bindings = <
&none  &none     &kp RIGHT_ALT  &none      &none      &none    &none       &none              &none            &none       &none  &btc
&none  &kp LGUI  &kp LALT       &kp LCTRL  &kp LSHFT  &none    &kp K_PREV  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &kp K_NEXT  &none  &none
&none  &none     &none          &none      &none      &none    &bt0        &bt1               &bt2             &bt3        &bt4   &ot
                                &none      &none      &none    &kp K_STOP  &kp C_PLAY_PAUSE   &kp C_MUTE
            >;
        };

        symbols {
            bindings = <
&none  &kp RA(APOS)         &kp LS(N7)  &kp LS(N8)     &kp LS(N9)        &kp RA(NON_US_HASH)    &none  &none      &none      &kp RIGHT_ALT  &none     &none
&none  &kp RA(LBKT)         &kp RS(N4)  &kp RS(N5)     &kp LS(N6)        &kp RA(RBKT)           &none  &kp RSHFT  &kp RCTRL  &kp LEFT_ALT   &kp RGUI  &none
&none  &kp LS(NON_US_BSLH)  &kp RS(N1)  &kp RS(N2)     &kp RS(N3)        &kp LS(GRAVE)          &none  &none      &none      &none          &none     &none
                                        &kp LS(EQUAL)  &kp LS(NUMBER_0)  &kp LS(MINUS)          &none  &none      &none
            >;
        };

        fun {
            bindings = <
&none  &kp F12  &kp F7  &kp F8      &kp F9     &kp PRINTSCREEN    &none  &none       &none      &kp RIGHT_ALT  &none     &none
&none  &kp F11  &kp F4  &kp F5      &kp F6     &kp SCROLLLOCK     &none  &kp RSHIFT  &kp RCTRL  &kp LEFT_ALT   &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2      &kp F3     &kp PAUSE_BREAK    &none  &none       &none      &none          &none     &none
                        &kp K_MENU  &kp SPACE  &kp TAB            &none  &none       &none
            >;
        };

        magic {
            bindings = <
&bootloader  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &bootloader
&none        &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none        &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                           &none  &none  &none    &none  &none  &none
            >;
        };
    };
};
